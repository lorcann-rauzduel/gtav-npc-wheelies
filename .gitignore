# Build output
obj/
bin/
*.pdb
*.exe

# IDE
.vs/
*.user
*.suo
*.cache

# Release archives (use GitHub Releases instead)
*.rar
*.zip
*.7z

# OS files
Thumbs.db
desktop.ini
.DS_Store

# Built DLLs (not tracked — build from source)
*.dll

# But track Release folder contents (INI + README for distribution)
!Release/
!Release/**
Release/scripts/*.dll
