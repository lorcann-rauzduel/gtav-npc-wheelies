<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <AssemblyName>StreetRiders</AssemblyName>
    <RootNamespace>StreetRiders</RootNamespace>
    <Version>2.0.1</Version>

    <!-- Your GTA V folder. Override it for your install: dotnet build /p:GTAPath="D:\Games\Grand Theft Auto V" -->
    <GTAPath Condition="'$(GTAPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Grand Theft Auto V</GTAPath>
    <OutputPath>$(GTAPath)\scripts\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Auto-copy DLL to dist/scripts after each build -->
  <Target Name="CopyToDist" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(MSBuildProjectDirectory)\..\dist\scripts\"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>$(GTAPath)\ScriptHookVDotNet3.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ScriptHookV">
      <HintPath>$(GTAPath)\ScriptHookV.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>