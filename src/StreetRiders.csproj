<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <AssemblyName>StreetRiders</AssemblyName>
    <RootNamespace>StreetRiders</RootNamespace>
    <Version>2.1.0</Version>
    
    <OutputPath>C:\Program Files (x86)\Steam\steamapps\common\Grand Theft Auto V\scripts\</OutputPath>
    
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Auto-copy DLL to dist/scripts after each build -->
  <Target Name="CopyToDist" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(MSBuildProjectDirectory)\..\dist\scripts\"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Grand Theft Auto V\ScriptHookVDotNet3.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ScriptHookV">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Grand Theft Auto V\ScriptHookV.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="LemonUI.SHVDN3">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Grand Theft Auto V\scripts\LemonUI.SHVDN3.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>